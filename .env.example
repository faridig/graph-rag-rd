# ACCRO Graph RAG — variables d'environnement requises
# Copier ce fichier en .env et remplir les valeurs

# Neo4j (docker compose up -d)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# API keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...

# SharePoint / Azure AD (scripts/download_essais.py uniquement)
AZURE_CLIENT_ID=       # ID app Azure AD (device code flow)
AZURE_TENANT_ID=       # ID tenant Microsoft 365
SHAREPOINT_HOSTNAME=nxtfoodfr.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/RD
SHAREPOINT_REPERTOIRE_ITEM_ID=  # sourcedoc= extrait de l'URL SharePoint du répertoire

# Optionnel
RAG_IDS_CACHE_TTL=300
SEMANTIC_SCHOLAR_API_KEY=  # clé gratuite sur semanticscholar.org/product/api — lève le rate-limit (10 req/s vs 1 req/s)
